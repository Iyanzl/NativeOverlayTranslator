<Window x:Class="NativeOverlayTranslator.ImageTranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image translation test"
        Width="760"
        Height="780"
        MinWidth="120"
        MinHeight="120"
        WindowStartupLocation="CenterScreen"
        Background="#202124">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2F3135" Padding="10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Retranslate" Padding="12,6" Click="Retranslate_OnClick" />
                <TextBlock x:Name="StatusText" Foreground="White" VerticalAlignment="Center" Text="Ready." />
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="ImageScroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#202124"
                      HorizontalContentAlignment="Left"
                      VerticalContentAlignment="Top">
            <Grid x:Name="ImageHost" HorizontalAlignment="Left" VerticalAlignment="Top" Background="White">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>
                <Image x:Name="SourceImage" Stretch="Fill" />
                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="True" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
