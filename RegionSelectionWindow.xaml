<Window x:Class="NativeOverlayTranslator.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#22000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross"
        KeyDown="Window_OnKeyDown"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown"
        MouseMove="Window_OnMouseMove"
        MouseLeftButtonUp="Window_OnMouseLeftButtonUp">
    <Canvas x:Name="RootCanvas">
        <Rectangle x:Name="SelectionRect"
                   Visibility="Collapsed"
                   Stroke="#00A8FF"
                   StrokeThickness="2"
                   Fill="#3300A8FF" />
        <Border Canvas.Left="16"
                Canvas.Top="16"
                Background="#DD111827"
                CornerRadius="6"
                Padding="10,7">
            <TextBlock Foreground="White"
                       Text="拖动选择 OCR 区域，Esc 取消"
                       FontSize="14" />
        </Border>
    </Canvas>
</Window>
